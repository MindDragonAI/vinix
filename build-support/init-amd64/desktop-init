#!/bin/sh
# PID 1 for the amd64 desktop image. The regular distro already supplies the
# shell and runtime libraries. The separate supervisor owns the unlock gate
# and desktop; all startup/session failures remain closed until reboot.

export HOME=/root
export TERM=linux
export PATH=/usr/local/bin:/bin:/sbin:/usr/bin:/usr/sbin
export USER=root
export LOGNAME=root
export SHELL=/bin/zsh
export XDG_RUNTIME_DIR=/run
export VINIX_SYSTEM_SESSION=1

# The home supervisor owns enrollment, unlock and the session. A missing or
# crashed supervisor is fatal; init never retries it with a reset rate budget.
/usr/libexec/vinix-home-gate --boot </dev/console &
gate_pid=$!
wait "$gate_pid"
# The supervisor puts its children in this group. Stop any orphan UI/session
# if it crashes; never replace it with a fresh budget or a recovery shell.
kill -TERM -- "-$gate_pid" 2>/dev/null || true
kill -KILL -- "-$gate_pid" 2>/dev/null || true
echo 'init: encrypted home supervisor stopped; locked until reboot' >/dev/com1 2>/dev/null
while :; do sleep 3600; done
